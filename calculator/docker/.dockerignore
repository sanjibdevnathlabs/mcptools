# Exclude test outputs
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
htmlcov/
.coverage
*.log

# Exclude environment files
*.env
.env.*
!.env.example

# Exclude development files
venv/
.vscode/
.idea/
*.swp
*.swo

# Exclude documentation
*.md
!README.md

# Exclude git
.git/
.gitignore

# Exclude other MCPs (only include calculator)
/database/
/weather/
/shared/

# Exclude build artifacts
dist/
build/
*.egg-info/

