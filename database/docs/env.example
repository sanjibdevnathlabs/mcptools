# =============================================================================
# Database MCP Server - Comprehensive Configuration Reference
# =============================================================================
# Copy this file to .env and uncomment/modify only the values you need to change
#
# ⚡ QUICK START: Only DATABASE_USER and DATABASE_PASSWORD are required!
# All other settings have sensible defaults shown below.

# =============================================================================
# DATABASE CONNECTION (Required)
# =============================================================================

# Database credentials - ONLY THESE ARE REQUIRED
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password

# Database connection details (defaults shown)
#DATABASE_HOST=localhost                 # MySQL/MariaDB server host
#DATABASE_PORT=3306                      # MySQL/MariaDB server port
#DATABASE_DATABASE=                      # Default database (leave empty for any database)
#DATABASE_CHARSET=utf8mb4                # Character set for connections

# =============================================================================
# CONNECTION POOL CONFIGURATION
# =============================================================================

# Pool sizing (good defaults for most applications)
#DATABASE_POOL_MINSIZE=1                 # Minimum connections to maintain
#DATABASE_POOL_MAXSIZE=10                # Maximum connections allowed
#DATABASE_POOL_RECYCLE=3600              # Pool connection recycle time (-1 for no recycle)

# Connection timeouts (in seconds)
#DATABASE_CONNECT_TIMEOUT=10.0           # Time to wait for initial connection
#DATABASE_READ_TIMEOUT=30.0              # Time to wait for query results
#DATABASE_WRITE_TIMEOUT=30.0             # Time to wait for write operations

# Query execution limits
#DATABASE_MAX_QUERY_LENGTH=1048576       # Maximum query size (1MB)
#DATABASE_QUERY_TIMEOUT=60.0             # Query execution timeout (seconds)
#DATABASE_MAX_ROWS_LIMIT=10000           # Maximum rows to return per query

# SSL/TLS Configuration (recommended for production)
#DATABASE_USE_SSL=false                  # Enable SSL/TLS encryption
#DATABASE_SSL_CA=/path/to/ca.pem         # Certificate Authority file
#DATABASE_SSL_CERT=/path/to/client-cert.pem  # Client certificate file
#DATABASE_SSL_KEY=/path/to/client-key.pem    # Client private key file
#DATABASE_VERIFY_SSL=true                # Verify SSL certificates

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Transport mode (how clients connect)
#SERVER_TRANSPORT_MODE=stdio             # stdio, sse, streamable-http, or auto
                                         # stdio: For Cursor/Copilot (uvx command)
                                         # streamable-http: For MCP Inspector/HTTP clients
                                         # sse: Server-Sent Events transport
                                         # auto: Detect based on environment

# Server settings (only needed for sse/streamable-http modes)
#SERVER_HOST=localhost                   # Host to bind to (use 0.0.0.0 for all interfaces)
#SERVER_PORT=8080                        # Port for HTTP-based transports
#SERVER_DEBUG=false                      # Enable debug mode with verbose logging

# SSE-specific settings
#SERVER_SSE_PATH=/sse                    # SSE endpoint path
#SERVER_SSE_MESSAGES_PATH=/messages      # SSE messages endpoint path

# CORS settings (for HTTP transports)
#SERVER_ENABLE_CORS=true                 # Enable Cross-Origin Resource Sharing
#SERVER_ALLOWED_ORIGINS=["*"]            # Allowed CORS origins (JSON array format)

# Health check endpoint
#SERVER_ENABLE_HEALTH_CHECK=true         # Enable /health endpoint
#SERVER_HEALTH_CHECK_PATH=/health        # Health check endpoint path

# =============================================================================
# LOGGING CONFIGURATION 
# =============================================================================

# 📊 JSON STRUCTURED LOGGING (Production-grade logging with trace codes)
#SERVER_LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
#SERVER_LOG_FORMAT=json                  # json = structured logging, text = human readable
#SERVER_LOG_DESTINATION=file             # file, stdout, stderr, both
                                         # file: Single rotating log file (recommended)
                                         # stdout: Console output only
                                         # stderr: Error stream only  
                                         # both: Console + file output

# Log file settings (when LOG_DESTINATION includes 'file')
#SERVER_LOG_FILE_PATH=./logs/database_mcp.log  # Log file location
#SERVER_LOG_MAX_FILE_SIZE=100MB          # Max file size before rotation (KB/MB/GB)
#SERVER_LOG_BACKUP_COUNT=5               # Number of backup files to keep

# Advanced logging features
#SERVER_LOG_INCLUDE_TIMESTAMP=true       # Include timestamp in log entries
#SERVER_LOG_INCLUDE_TRACE_ID=true        # Include trace ID for request tracking

# =============================================================================
# MCP SERVER SETTINGS
# =============================================================================

# Server identification
#MCP_SERVER_NAME=database-mcp            # MCP server name
#MCP_SERVER_VERSION=1.0.0                # MCP server version

# 🎯 TOOL CONFIGURATION (Control UI complexity)
#MCP_TOOL_MODE=lite                      # lite = 8 core tools (perfect for AI clients)
                                         # full = 22 tools (enterprise/power users)
                                         # ⭐ RECOMMENDED: Use 'lite' for Cursor/Copilot

# Feature toggles (enable/disable major features)
#MCP_ENABLE_QUERY_EXECUTION=true         # Allow SQL query execution
#MCP_ENABLE_SCHEMA_INTROSPECTION=true    # Allow database schema browsing
#MCP_ENABLE_QUERY_EXPLAIN=true           # Allow query execution plan analysis

# Safety settings
#MCP_READONLY_MODE=false                 # Enable read-only mode (SELECT queries only)
#MCP_ALLOWED_QUERY_TYPES=["SELECT", "SHOW", "DESCRIBE", "EXPLAIN"]  # Allowed query types (JSON array)

# Rate limiting (prevent abuse)
#MCP_ENABLE_RATE_LIMITING=true           # Enable query rate limiting
#MCP_MAX_QUERIES_PER_MINUTE=100          # Maximum queries per minute per client

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# SQL injection protection
#SECURITY_ENABLE_INJECTION_DETECTION=true     # Detect potentially malicious queries
#SECURITY_BLOCK_DANGEROUS_QUERIES=true        # Block DROP, DELETE, TRUNCATE, etc.
#SECURITY_AUDIT_LOGGING=true                  # Log all security events

# Access control
#SECURITY_ENABLE_IP_WHITELIST=false           # Restrict access by IP address
#SECURITY_ALLOWED_IPS=127.0.0.1,192.168.1.0/24  # Comma-separated IPs/CIDRs

# Authentication (for HTTP transports)
#SECURITY_ENABLE_AUTH=false                   # Enable basic authentication
#SECURITY_USERNAME=admin                      # Username for HTTP auth
#SECURITY_PASSWORD=secure_password            # Password for HTTP auth

# =============================================================================
# MONITORING AND METRICS
# =============================================================================

# Performance monitoring
#MONITORING_ENABLE_METRICS=true               # Collect performance metrics
#MONITORING_METRICS_INTERVAL=60               # Metrics collection interval (seconds)
#MONITORING_ENABLE_HEALTH_CHECKS=true         # Enable comprehensive health checks

# Error tracking
#MONITORING_ENABLE_ERROR_TRACKING=true        # Track and aggregate errors
#MONITORING_ERROR_RETENTION_DAYS=30           # Keep error logs for N days

# Resource monitoring
#MONITORING_TRACK_MEMORY_USAGE=true           # Monitor memory consumption
#MONITORING_TRACK_CPU_USAGE=true              # Monitor CPU usage
#MONITORING_TRACK_CONNECTION_POOL=true        # Monitor database connections

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# General logging
#LOG_ENABLE_FILE_LOGGING=true                 # Save logs to files (recommended)
#LOG_DIRECTORY=./logs                          # Directory for log files
#LOG_MAX_FILE_SIZE=10MB                        # Maximum size per log file
#LOG_BACKUP_COUNT=5                            # Number of backup files to keep

# Log levels (DEBUG, INFO, WARNING, ERROR, CRITICAL)
#LOG_LEVEL_DATABASE=INFO                       # Database operations logging
#LOG_LEVEL_SECURITY=WARNING                    # Security events logging
#LOG_LEVEL_MONITORING=INFO                     # Monitoring and metrics logging
#LOG_LEVEL_MCP=INFO                            # MCP protocol logging
#SERVER_LOG_LEVEL=INFO                         # Overall server log level

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Circuit breaker pattern (prevent cascading failures)
#CIRCUIT_BREAKER_ENABLED=true                 # Enable circuit breaker protection
#CIRCUIT_BREAKER_FAILURE_THRESHOLD=5          # Failures before opening circuit
#CIRCUIT_BREAKER_TIMEOUT=60                   # Circuit open timeout (seconds)

# Query result caching
#CACHE_ENABLED=false                           # Enable query result caching
#CACHE_TTL=300                                 # Cache time-to-live (seconds)
#CACHE_MAX_SIZE=100                            # Maximum cached queries

# Schema management
#SCHEMA_AUTO_DISCOVERY=true                    # Automatically discover schema changes
#SCHEMA_CACHE_ENABLED=true                     # Cache schema metadata
#SCHEMA_CACHE_TTL=3600                         # Schema cache TTL (seconds)

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Development features
#DEV_ENABLE_QUERY_EXPLAIN=true                # Enable EXPLAIN for debugging
#DEV_ENABLE_QUERY_PROFILING=false             # Enable query profiling
#DEV_MOCK_DATA_ENABLED=false                  # Use mock data for testing

# Testing configuration
#TEST_DATABASE_PREFIX=test_                    # Prefix for test databases
#TEST_ENABLE_FIXTURES=false                   # Enable test data fixtures

# =============================================================================
# QUICK START EXAMPLES
# =============================================================================

# 1. 🚀 Minimal Setup (Cursor/Copilot):
#    DATABASE_USER=root
#    DATABASE_PASSWORD=your_password
#    # That's it! All other settings use defaults
#
# 2. 🔍 MCP Inspector Testing:
#    DATABASE_USER=root
#    DATABASE_PASSWORD=your_password
#    SERVER_TRANSPORT_MODE=streamable-http
#    SERVER_PORT=8080
#
# 3. 🏢 Production HTTP Server:
#    DATABASE_USER=prod_user
#    DATABASE_PASSWORD=secure_password
#    DATABASE_HOST=prod-mysql.company.com
#    DATABASE_USE_SSL=true
#    SERVER_TRANSPORT_MODE=streamable-http
#    SERVER_HOST=0.0.0.0
#    SERVER_PORT=8080
#    MCP_TOOL_MODE=full
#    SECURITY_ENABLE_AUTH=true
#    SECURITY_USERNAME=api_user
#    SECURITY_PASSWORD=api_secure_password
#
# 4. 🛡️ High Security Setup:
#    DATABASE_USER=readonly_user
#    DATABASE_PASSWORD=readonly_password
#    MCP_READONLY_MODE=true
#    MCP_ALLOWED_QUERY_TYPES=["SELECT", "SHOW", "DESCRIBE"]
#    SECURITY_ENABLE_INJECTION_DETECTION=true
#    SECURITY_BLOCK_DANGEROUS_QUERIES=true
#    MCP_ENABLE_RATE_LIMITING=true
#    MCP_MAX_QUERIES_PER_MINUTE=50

